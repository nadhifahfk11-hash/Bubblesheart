<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bubblesheart - Kelompok 2 | Kelas X.D</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom Style CSS -->
    <link rel="stylesheet" href="style.css">
</head>
<body class="relative overflow-x-hidden pb-16">

    <!-- Background Floating Decorations -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
        <div class="absolute top-10 left-10 w-36 h-36 bg-pink-300 rounded-full mix-blend-multiply filter blur-xl opacity-40 floating"></div>
        <div class="absolute top-1/3 right-10 w-52 h-52 bg-blue-300 rounded-full mix-blend-multiply filter blur-xl opacity-40 floating-delayed"></div>
        <div class="absolute bottom-20 left-1/4 w-44 h-44 bg-purple-300 rounded-full mix-blend-multiply filter blur-xl opacity-30 floating"></div>
        
        <i class="fa-solid fa-sparkles text-yellow-200 text-3xl absolute top-24 left-1/5 opacity-80 floating"></i>
        <i class="fa-solid fa-cloud text-white opacity-40 text-6xl absolute top-40 right-1/4 floating-delayed"></i>
        <i class="fa-solid fa-butterfly text-pink-200 opacity-70 text-5xl absolute top-1/2 left-8 floating"></i>
        <i class="fa-solid fa-butterfly text-pink-200 opacity-70 text-6xl absolute top-1/3 right-12 floating-delayed"></i>
    </div>

    <!-- Header Navigation Bar -->
    <header class="sticky top-0 z-40 glass-nav transition-all duration-300">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <img src="https://i.ibb.co/L8bTh0p/logo-bubblesheart.png" alt="Bubblesheart Logo" class="h-10 w-auto object-contain drop-shadow" onerror="this.src='https://via.placeholder.com/150?text=Bubblesheart'">
                <span class="font-extrabold text-xl text-blue-900 tracking-wide font-poppins">BUBBLESHEART</span>
            </div>

            <!-- Navigation Links -->
            <nav class="flex items-center space-x-2 sm:space-x-3 bg-white/70 p-1.5 rounded-full border border-white/90 shadow-sm">
                <button onclick="switchTab('beranda')" id="tab-beranda" class="tab-btn active px-5 py-2 rounded-full font-bold text-sm transition-all duration-200">
                    <i class="fa-solid fa-house mr-1.5"></i> Beranda
                </button>
                <button onclick="switchTab('desain')" id="tab-desain" class="tab-btn text-gray-600 hover:text-blue-600 px-5 py-2 rounded-full font-bold text-sm transition-all duration-200">
                    <i class="fa-solid fa-palette mr-1.5"></i> Desain
                </button>
                <button onclick="switchTab('produk')" id="tab-produk" class="tab-btn text-gray-600 hover:text-blue-600 px-5 py-2 rounded-full font-bold text-sm transition-all duration-200">
                    <i class="fa-solid fa-box-open mr-1.5"></i> Produk
                </button>
            </nav>
        </div>
    </header>

    <!-- Main Section -->
    <main class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 pt-8 pb-12">
        
        <!-- Header Banner -->
        <div class="text-center my-8">
            <h1 class="text-5xl sm:text-7xl font-black tracking-wider bubble-text-3d font-poppins mb-3 transform hover:scale-105 transition-transform duration-300">
                BUBBLESHEART
            </h1>
            <div class="inline-flex items-center px-4 py-1.5 rounded-full bg-white/80 backdrop-blur-md border border-white text-blue-900 font-extrabold text-sm shadow-sm">
                <span class="w-2.5 h-2.5 rounded-full bg-pink-500 animate-ping mr-2"></span>
                KELOMPOK 2 | KELAS X.D
            </div>
        </div>

        <!-- Content Card -->
        <div class="glass-card rounded-3xl p-6 sm:p-10 transition-all duration-500">
            
            <!-- SECTION 1: BERANDA -->
            <div id="content-beranda" class="tab-content space-y-12">
                
                <!-- Logo & Filosofi Block -->
                <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center bg-white/60 p-6 sm:p-8 rounded-2xl border border-white/90 shadow-inner">
                    <div class="md:col-span-5 flex flex-col items-center justify-center p-2">
                        <div class="relative group">
                            <div class="absolute -inset-1 bg-gradient-to-r from-pink-400 to-blue-400 rounded-2xl blur opacity-30 group-hover:opacity-60 transition duration-500"></div>
                            <img src="https://i.ibb.co/L8bTh0p/logo-bubblesheart.png" alt="Logo Bubblesheart" class="relative max-w-[220px] w-full h-auto object-contain drop-shadow-md hover:scale-105 transition duration-300">
                        </div>
                    </div>

                    <div class="md:col-span-7 space-y-4">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shadow-md">
                                <i class="fa-solid fa-heart text-lg"></i>
                            </div>
                            <h2 class="text-2xl font-bold text-gray-800 font-poppins">Filosofi Logo Bubblesheart</h2>
                        </div>
                        <p class="text-gray-700 leading-relaxed text-justify text-sm sm:text-base">
                            Logo kami memiliki filosofi yaitu Logo Bublehearts berbentuk hati dengan tampilan gelembung berwarna pastel yang berkilau. Bentuk hati melambangkan kebersamaan, kepedulian, dan rasa saling menghargai antaranggota kelompok. Gelembung menggambarkan lima anggota yang memiliki sifat, ide, dan kemampuan berbeda, tetapi tetap bisa bersatu dan bekerja sama. Warna pastel melambangkan kreativitas dan suasana kelompok yang positif, sedangkan kilauan pada logo menggambarkan kelebihan setiap anggota yang saling melengkapi. Secara keseluruhan, Bublehearts melambangkan lima orang yang berbeda karakter, tetapi memiliki tujuan yang sama. Dengan kekompakan, rasa saling percaya, dan kerja sama, setiap anggota dapat saling mendukung untuk mencapai hasil yang lebih baik bersama-sama.
                        </p>
                    </div>
                </div>

                <!-- PRESENTASI PPT (Terranova Space) -->
                <div class="space-y-4 pt-2">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-xl bg-purple-600 text-white flex items-center justify-center shadow-md">
                                <i class="fa-solid fa-file-powerpoint text-lg"></i>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-gray-800 font-poppins">Presentasi Kelompok (PPT)</h3>
                                <p class="text-xs text-gray-500">Pratinjau slide presentasi proyek Bubblesheart</p>
                            </div>
                        </div>
                        <button onclick="toggleFullScreenPPT()" class="inline-flex items-center space-x-2 text-xs font-semibold text-purple-700 bg-purple-50 hover:bg-purple-100 px-3 py-2 rounded-lg border border-purple-200 transition">
                            <i class="fa-solid fa-expand"></i>
                            <span>Layar Penuh</span>
                        </button>
                    </div>

                    <!-- PPT Viewer Frame Container -->
                    <div class="relative w-full rounded-2xl overflow-hidden bg-slate-900 border-2 border-white shadow-xl">
                        <div class="relative w-full pt-[56.25%]">
                            <!-- Embed Google Slides / PDF Viewer -->
                            <iframe 
                                id="ppt-iframe"
                                src="https://docs.google.com/presentation/d/e/2PACX-1vQ3Xn-placeholder/embed?start=false&loop=false&delayms=3000" 
                                frameborder="0" 
                                class="absolute top-0 left-0 w-full h-full"
                                allowfullscreen="true">
                            </iframe>

                            <!-- Placeholder Overlay jika belum diisi link Google Slides -->
                            <div id="ppt-placeholder" class="absolute inset-0 bg-slate-900/90 backdrop-blur-sm flex flex-col items-center justify-center text-white p-6 text-center space-y-4">
                                <div class="w-16 h-16 rounded-full bg-pink-500/20 border border-pink-400 flex items-center justify-center text-pink-400 text-3xl animate-pulse">
                                    <i class="fa-solid fa-file-powerpoint"></i>
                                </div>
                                <div class="max-w-md">
                                    <h4 class="text-lg font-bold">Space Presentasi PowerPoint</h4>
                                    <p class="text-xs text-slate-300 mt-1">Area ini telah disiapkan untuk menyematkan slide presentasi PPT proyek Anda secara interaktif.</p>
                                </div>
                                <div class="text-xs text-slate-400 bg-slate-800 px-4 py-2 rounded-lg border border-slate-700">
                                    <i class="fa-solid fa-circle-info mr-1 text-blue-400"></i> Untuk mengganti slide, ganti URL <code>src</code> pada tag <code>iframe</code> di file <code>index.html</code>.
                                </div>
                            </div>
                        </div>

                        <!-- Bar Kontrol PPT -->
                        <div class="bg-slate-800 px-4 py-2.5 flex items-center justify-between text-xs text-slate-300">
                            <span class="flex items-center">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 mr-2"></span>
                                Bubblesheart Presentation Slide
                            </span>
                            <button onclick="toggleFullScreenPPT()" class="hover:text-white transition flex items-center space-x-1">
                                <i class="fa-solid fa-expand"></i>
                                <span>Layar Penuh</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ANGGOTA KELOMPOK -->
                <div class="space-y-6 pt-2">
                    <div class="text-center max-w-xl mx-auto space-y-1">
                        <h3 class="text-2xl font-bold text-gray-800 font-poppins">Anggota Kelompok</h3>
                        <p class="text-sm text-gray-600">Klik profil anggota di bawah ini untuk melihat detail perannya</p>
                    </div>

                    <!-- Grid Anggota -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                        
                        <!-- 1. Aura Dwi (Web Programmer) -->
                        <div onclick="openMemberModal('Aura Dwi', 'Web Programmer', 'Bertanggung jawab dalam penulisan logika kode HTML/CSS/JS, memprogram fitur interaktif pada web, serta memastikan struktur kode berjalan optimal.', 'https://i.ibb.co/3ykXG9g/aura.jpg', ['HTML/CSS', 'JavaScript', 'Web Logic'])" 
                             class="group bg-white/80 rounded-2xl p-4 border border-white hover:border-pink-300 shadow-sm hover:shadow-lg transition-all duration-300 cursor-pointer flex items-center space-x-4 transform hover:-translate-y-1">
                            <div class="relative">
                                <img src="https://i.ibb.co/3ykXG9g/aura.jpg" alt="Aura Dwi" class="w-16 h-16 rounded-2xl object-cover object-center shadow-md group-hover:scale-105 transition duration-300">
                                <span class="absolute -bottom-1 -right-1 bg-pink-500 text-white text-[10px] p-1 rounded-lg">
                                    <i class="fa-solid fa-code"></i>
                                </span>
                            </div>
                            <div>
                                <h4 class="font-bold text-gray-800 group-hover:text-pink-600 transition">Aura Dwi</h4>
                                <p class="text-xs font-semibold text-pink-500">Web Programmer</p>
                                <span class="inline-block text-[10px] text-gray-500 mt-1">Lihat Profil <i class="fa-solid fa-chevron-right text-[8px] ml-0.5"></i></span>
                            </div>
                        </div>

                        <!-- 2. Nadhifah Faiha (Web Developer) -->
                        <div onclick="openMemberModal('Nadhifah Faiha', 'Web Developer', 'Mengatur pengembangan repositori GitHub Pages, mengelola deployment website, serta memastikan semua komponen web terintegrasi dengan baik.', 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300&auto=format&fit=crop&q=80', ['Web Deployment', 'GitHub Pages', 'Frontend Dev'])" 
                             class="group bg-white/80 rounded-2xl p-4 border border-white hover:border-blue-300 shadow-sm hover:shadow-lg transition-all duration-300 cursor-pointer flex items-center space-x-4 transform hover:-translate-y-1">
                            <div class="relative">
                                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300&auto=format&fit=crop&q=80" alt="Nadhifah Faiha" class="w-16 h-16 rounded-2xl object-cover shadow-md group-hover:scale-105 transition duration-300">
                                <span class="absolute -bottom-1 -right-1 bg-blue-500 text-white text-[10px] p-1 rounded-lg">
                                    <i class="fa-solid fa-laptop-code"></i>
                                </span>
                            </div>
                            <div>
                                <h4 class="font-bold text-gray-800 group-hover:text-blue-600 transition">Nadhifah Faiha</h4>
                                <p class="text-xs font-semibold text-blue-500">Web Developer</p>
                                <span class="inline-block text-[10px] text-gray-500 mt-1">Lihat Profil <i class="fa-solid fa-chevron-right text-[8px] ml-0.5"></i></span>
                            </div>
                        </div>

                        <!-- 3. Farah Nabila (Web Architect) -->
                        <div onclick="openMemberModal('Farah Nabila', 'Web Architect', 'Merancang tata letak struktur informasi halaman, menyusun skema alur navigasi web, dan memastikan alur pengguna (UX) tertata rapi.', 'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=300&auto=format&fit=crop&q=80', ['Information Architecture', 'Wireframing', 'UX Planning'])" 
                             class="group bg-white/80 rounded-2xl p-4 border border-white hover:border-purple-300 shadow-sm hover:shadow-lg transition-all duration-300 cursor-pointer flex items-center space-x-4 transform hover:-translate-y-1">
                            <div class="relative">
                                <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=300&auto=format&fit=crop&q=80" alt="Farah Nabila" class="w-16 h-16 rounded-2xl object-cover shadow-md group-hover:scale-105 transition duration-300">
                                <span class="absolute -bottom-1 -right-1 bg-purple-500 text-white text-[10px] p-1 rounded-lg">
                                    <i class="fa-solid fa-sitemap"></i>
                                </span>
                            </div>
                            <div>
                                <h4 class="font-bold text-gray-800 group-hover:text-purple-600 transition">Farah Nabila</h4>
                                <p class="text-xs font-semibold text-purple-500">Web Architect</p>
                                <span class="inline-block text-[10px] text-gray-500 mt-1">Lihat Profil <i class="fa-solid fa-chevron-right text-[8px] ml-0.5"></i></span>
                            </div>
                        </div>

                        <!-- 4. Kannisa (Web Designer) -->
                        <div onclick="openMemberModal('Kannisa', 'Web Designer', 'Mendesain elemen visual antarmuka web, merancang perpaduan warna pastel yang manis, serta memilih aset grafis pendukung.', 'https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=300&auto=format&fit=crop&q=80', ['UI Design', 'Color Theory', 'Visual Assets'])" 
                             class="group bg-white/80 rounded-2xl p-4 border border-white hover:border-emerald-300 shadow-sm hover:shadow-lg transition-all duration-300 cursor-pointer flex items-center space-x-4 transform hover:-translate-y-1">
                            <div class="relative">
                                <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=300&auto=format&fit=crop&q=80" alt="Kannisa" class="w-16 h-16 rounded-2xl object-cover shadow-md group-hover:scale-105 transition duration-300">
                                <span class="absolute -bottom-1 -right-1 bg-emerald-500 text-white text-[10px] p-1 rounded-lg">
                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                </span>
                            </div>
                            <div>
                                <h4 class="font-bold text-gray-800 group-hover:text-emerald-600 transition">Kannisa</h4>
                                <p class="text-xs font-semibold text-emerald-500">Web Designer</p>
                                <span class="inline-block text-[10px] text-gray-500 mt-1">Lihat Profil <i class="fa-solid fa-chevron-right text-[8px] ml-0.5"></i></span>
                            </div>
                        </div>

                        <!-- 5. Khalilla (Web Designer) -->
                        <div onclick="openMemberModal('Khalilla', 'Web Designer', 'Bekerjasama menyusun estetika antarmuka (UI), memastikan setiap elemen visual estetik, serta merancang banner dan ornamen web.', 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=300&auto=format&fit=crop&q=80', ['Aesthetics', 'UI Layout', 'Creative Assets'])" 
                             class="group bg-white/80 rounded-2xl p-4 border border-white hover:border-indigo-300 shadow-sm hover:shadow-lg transition-all duration-300 cursor-pointer flex items-center space-x-4 transform hover:-translate-y-1">
                            <div class="relative">
                                <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=300&auto=format&fit=crop&q=80" alt="Khalilla" class="w-16 h-16 rounded-2xl object-cover shadow-md group-hover:scale-105 transition duration-300">
                                <span class="absolute -bottom-1 -right-1 bg-indigo-500 text-white text-[10px] p-1 rounded-lg">
                                    <i class="fa-solid fa-paint-brush"></i>
                                </span>
                            </div>
                            <div>
                                <h4 class="font-bold text-gray-800 group-hover:text-indigo-600 transition">Khalilla</h4>
                                <p class="text-xs font-semibold text-indigo-500">Web Designer</p>
                                <span class="inline-block text-[10px] text-gray-500 mt-1">Lihat Profil <i class="fa-solid fa-chevron-right text-[8px] ml-0.5"></i></span>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

            <!-- SECTION 2: DESAIN -->
            <div id="content-desain" class="tab-content hidden space-y-6">
                <div class="text-center py-8 space-y-3">
                    <div class="w-16 h-16 rounded-full bg-pink-100 text-pink-500 flex items-center justify-center mx-auto text-2xl">
                        <i class="fa-solid fa-palette"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-800 font-poppins">Katalog Desain Proyek</h3>
                    <p class="text-gray-600 max-w-md mx-auto text-sm">Aset visual, sketsa wireframe, dan mockup rancangan desain kelompok Bubblesheart.</p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="bg-white/70 p-5 rounded-2xl border border-white text-center">
                        <div class="h-40 bg-pink-50 rounded-xl flex items-center justify-center text-pink-300 mb-3">
                            <i class="fa-solid fa-image text-4xl"></i>
                        </div>
                        <h4 class="font-bold text-gray-800">Sketsa Wireframe</h4>
                        <p class="text-xs text-gray-500 mt-1">Konsep awal tata letak antarmuka web</p>
                    </div>
                    <div class="bg-white/70 p-5 rounded-2xl border border-white text-center">
                        <div class="h-40 bg-blue-50 rounded-xl flex items-center justify-center text-blue-300 mb-3">
                            <i class="fa-solid fa-swatchbook text-4xl"></i>
                        </div>
                        <h4 class="font-bold text-gray-800">Palet Warna Pastel</h4>
                        <p class="text-xs text-gray-500 mt-1">Kombinasi warna pastel dan ikon gelembung</p>
                    </div>
                </div>
            </div>

            <!-- SECTION 3: PRODUK -->
            <div id="content-produk" class="tab-content hidden space-y-6">
                <div class="text-center py-8 space-y-3">
                    <div class="w-16 h-16 rounded-full bg-blue-100 text-blue-500 flex items-center justify-center mx-auto text-2xl">
                        <i class="fa-solid fa-box-open"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-800 font-poppins">Hasil Produk Proyek</h3>
                    <p class="text-gray-600 max-w-md mx-auto text-sm">Produk akhir dari proyek situs web kelompok Bubblesheart.</p>
                </div>
                <div class="bg-white/70 p-6 rounded-2xl border border-white text-center max-w-md mx-auto shadow-sm">
                    <i class="fa-solid fa-rocket text-blue-500 text-3xl mb-3"></i>
                    <h4 class="font-bold text-gray-800">Web App Bubblesheart</h4>
                    <p class="text-xs text-gray-500 mt-1">Situs web interaktif berbasis GitHub Pages.</p>
                </div>
            </div>

        </div>

    </main>

    <!-- Modal Profil Anggota -->
    <div id="member-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md transition-opacity duration-300">
        <div class="bg-white rounded-3xl max-w-md w-full overflow-hidden shadow-2xl transform transition-all duration-300 scale-95 opacity-0" id="modal-container">
            
            <div class="relative h-28 bg-gradient-to-r from-pink-400 via-purple-400 to-blue-400 p-4 flex justify-end">
                <button onclick="closeMemberModal()" class="w-8 h-8 rounded-full bg-white/80 hover:bg-white text-gray-700 flex items-center justify-center transition shadow">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="px-6 pb-6 pt-0 relative">
                <div class="relative -mt-12 mb-4">
                    <img id="modal-img" src="" alt="" class="w-24 h-24 rounded-2xl object-cover border-4 border-white shadow-md">
                </div>

                <div class="space-y-3">
                    <div>
                        <h3 id="modal-name" class="text-2xl font-bold text-gray-800 font-poppins">Nama Anggota</h3>
                        <p id="modal-role" class="text-sm font-bold text-pink-500">Peran / Posisi</p>
                    </div>

                    <div class="bg-gray-50 p-4 rounded-xl border border-gray-100">
                        <h5 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Peran & Tugas</h5>
                        <p id="modal-desc" class="text-sm text-gray-600 leading-relaxed">Deskripsi tugas anggota dalam kelompok...</p>
                    </div>

                    <div>
                        <h5 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Keahlian</h5>
                        <div id="modal-skills" class="flex flex-wrap gap-1.5">
                        </div>
                    </div>
                </div>

                <button onclick="closeMemberModal()" class="w-full mt-6 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-sm transition">
                    Tutup Profil
                </button>
            </div>

        </div>
    </div>

    <!-- Custom Script JS -->
    <script src="script.js"></script>
</body>
</html>
