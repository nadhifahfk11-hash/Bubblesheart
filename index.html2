<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bubbles Heart | Kelompok 2 - Kelas X. D</title>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
  
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Main Stylesheet -->
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <!-- Canvas Animasi Gelembung Latar Belakang -->
  <div id="bubble-container" class="bubble-container"></div>
  
  <!-- Ornamen Kupu-Kupu Melayang Lucu -->
  <div class="butterfly butterfly-left">
    <div class="wing left-wing"></div>
    <div class="body"></div>
    <div class="wing right-wing"></div>
  </div>
  <div class="butterfly butterfly-right">
    <div class="wing left-wing"></div>
    <div class="body"></div>
    <div class="wing right-wing"></div>
  </div>

  <!-- Awan Lucu & Bintang Berkelap-Kelip -->
  <div class="cloud-decor cloud-1"><i class="fa-solid fa-cloud"></i></div>
  <div class="cloud-decor cloud-2"><i class="fa-solid fa-cloud"></i></div>
  <div class="star-decor star-1">✦</div>
  <div class="star-decor star-2">★</div>
  <div class="star-decor star-3">✦</div>
  <div class="star-decor star-4">★</div>

  <div class="page-wrapper">
    <!-- Header / Navbar -->
    <header class="navbar-container">
      <div class="nav-brand">
        <span class="brand-icon">🫧</span>
        <span class="brand-text">BUBBLES HEART</span>
      </div>
      <div class="nav-pill">
        <span class="badge-tag">Kelompok 2</span>
        <span class="divider">•</span>
        <span class="badge-tag">Kelas X. D</span>
      </div>
      <button id="sound-btn" class="sound-toggle-btn" title="Nyalakan / Matikan Efek Suara Gelembung">
        <i class="fa-solid fa-volume-high"></i>
        <span>Sound: ON</span>
      </button>
    </header>

    <!-- Hero Banner Section -->
    <section class="hero-section">
      <div class="banner-wrapper">
        <img src="background.png" alt="Bubbles Heart - Kelompok 2 Kelas X. D" class="hero-banner-image" onerror="this.style.display='none'">
      </div>
      <div class="hero-card">
        <div class="hero-tag">
          <span class="sparkle-icon">✨</span> PROYEK PENGEMBANGAN WEBSITE <span class="sparkle-icon">✨</span>
        </div>
        <h1 class="hero-title">
          <span class="title-bubbles">BUBBLES</span>
          <span class="ribbon-decor">🎀</span>
          <span class="title-heart">HEART</span>
        </h1>
        <p class="hero-subtitle">
          Selamat datang di website resmi karya <strong>Kelompok 2 • Kelas X. D</strong>.<br>
          Dibuat dengan sentuhan estetika ceria, warna pastel manis, dan kolaborasi tim yang solid!
        </p>
        <div class="hero-action-row">
          <a href="#team-section" class="btn-bubble btn-primary">
            <i class="fa-solid fa-heart"></i> Kenali Tim Kami
          </a>
          <a href="#about-section" class="btn-bubble btn-secondary">
            <i class="fa-solid fa-sparkles"></i> Tentang Proyek
          </a>
        </div>
      </div>
    </section>

    <!-- Team Members Section -->
    <section id="team-section" class="team-section">
      <div class="section-header">
        <div class="section-badge">🌸 Meet Our Dream Team 🌸</div>
        <h2 class="section-title">Susunan Tim Pengembang</h2>
        <p class="section-desc">Kolaborasi 5 individu berbakat dibalik pembuatan website Bubbles Heart</p>
      </div>

      <div class="team-grid">
        <!-- 1. Aura Dwi Ramadhani - Web Programmer -->
        <div class="member-card programmer-card" data-tilt>
          <div class="card-glow"></div>
          <div class="role-badge badge-programmer">
            <i class="fa-solid fa-code"></i> Web Programmer
          </div>
          <div class="avatar-wrapper">
            <div class="avatar-ring">
              <span class="avatar-emoji">💻</span>
            </div>
            <div class="sparkle-bubble">✨</div>
          </div>
          <h3 class="member-name">Aura Dwi Ramadhani</h3>
          <p class="member-title">Lead Programmer</p>
          <p class="member-desc">
            Bertanggung jawab penuh atas penulisan logika sistem, efisiensi kode, animasi interaktif, serta memastikan website berjalan cepat dan tanpa celah error.
          </p>
          <div class="skills-tags">
            <span class="tag">JavaScript</span>
            <span class="tag">System Logic</span>
            <span class="tag">Interactivity</span>
          </div>
        </div>

        <!-- 2. Nadhifah Faiha - Web Architect -->
        <div class="member-card architect-card" data-tilt>
          <div class="card-glow"></div>
          <div class="role-badge badge-architect">
            <i class="fa-solid fa-sitemap"></i> Web Architect
          </div>
          <div class="avatar-wrapper">
            <div class="avatar-ring">
              <span class="avatar-emoji">🏛️</span>
            </div>
            <div class="sparkle-bubble">🌸</div>
          </div>
          <h3 class="member-name">Nadhifah Faiha</h3>
          <p class="member-title">System & Structure Architect</p>
          <p class="member-desc">
            Merancang blueprint dan fondasi arsitektur website, memetakan alur navigasi proyek, standarisasi struktur file, serta integrasi keseluruhan sistem.
          </p>
          <div class="skills-tags">
            <span class="tag">System Design</span>
            <span class="tag">File Structure</span>
            <span class="tag">Integration</span>
          </div>
        </div>

        <!-- 3. Farah Nabila - Web Developer -->
        <div class="member-card developer-card" data-tilt>
          <div class="card-glow"></div>
          <div class="role-badge badge-developer">
            <i class="fa-solid fa-laptop-code"></i> Web Developer
          </div>
          <div class="avatar-wrapper">
            <div class="avatar-ring">
              <span class="avatar-emoji">🚀</span>
            </div>
            <div class="sparkle-bubble">💖</div>
          </div>
          <h3 class="member-name">Farah Nabila</h3>
          <p class="member-title">Core Web Developer</p>
          <p class="member-desc">
            Mengimplementasikan desain ke dalam bentuk kode HTML5 & CSS modern, membangun modul-modul web, dan menguji responsivitas di berbagai perangkat.
          </p>
          <div class="skills-tags">
            <span class="tag">HTML5 & CSS3</span>
            <span class="tag">Component Build</span>
            <span class="tag">Responsive</span>
          </div>
        </div>

        <!-- 4. Kannisa Desfitra - Web Designer -->
        <div class="member-card designer-card" data-tilt>
          <div class="card-glow"></div>
          <div class="role-badge badge-designer">
            <i class="fa-solid fa-palette"></i> Web Designer
          </div>
          <div class="avatar-wrapper">
            <div class="avatar-ring">
              <span class="avatar-emoji">🎨</span>
            </div>
            <div class="sparkle-bubble">🎀</div>
          </div>
          <h3 class="member-name">Kannisa Desfitra</h3>
          <p class="member-title">UI & Aesthetic Designer</p>
          <p class="member-desc">
            Menciptakan komposisi warna pastel yang harmonis, merancang antarmuka Glassmorphism yang estetik, dan memastikan kenyamanan pengalaman visual pengguna.
          </p>
          <div class="skills-tags">
            <span class="tag">UI/UX Layout</span>
            <span class="tag">Color Harmony</span>
            <span class="tag">Glassmorphism</span>
          </div>
        </div>

        <!-- 5. Khalilla Andien - Web Designer -->
        <div class="member-card designer-card" data-tilt>
          <div class="card-glow"></div>
          <div class="role-badge badge-designer">
            <i class="fa-solid fa-wand-magic-sparkles"></i> Web Designer
          </div>
          <div class="avatar-wrapper">
            <div class="avatar-ring">
              <span class="avatar-emoji">✨</span>
            </div>
            <div class="sparkle-bubble">🎈</div>
          </div>
          <h3 class="member-name">Khalilla Andien</h3>
          <p class="member-title">Visual & Asset Designer</p>
          <p class="member-desc">
            Merancang aset visual kreatif, elemen 3D balon imut bertema Bubbles Heart, tipografi manis, serta detail mikro-interaksi yang memanjakan mata.
          </p>
          <div class="skills-tags">
            <span class="tag">Asset Creation</span>
            <span class="tag">Typography</span>
            <span class="tag">Visual Accents</span>
          </div>
        </div>
      </div>
    </section>

    <!-- About Project Section -->
    <section id="about-section" class="about-section">
      <div class="about-card">
        <div class="about-content">
          <div class="section-badge">💡 Makna Proyek</div>
          <h2 class="about-title">Tentang Proyek Bubbles Heart</h2>
          <p class="about-text">
            <strong>Bubbles Heart</strong> melambangkan mimpi dan kreativitas yang mengalir bebas layaknya gelembung udara, disatukan oleh kehangatan hati serta semangat persahabatan <strong>Kelompok 2 Kelas X. D</strong>.
          </p>
          <p class="about-text">
            Proyek ini memadukan konsep antarmuka modern berbahan kaca (<em>Glassmorphism</em>), animasi mengambang lembut, dan perpaduan warna biru langit serta merah muda ceria.
          </p>

          <div class="stats-row">
            <div class="stat-box">
              <span class="stat-number">5</span>
              <span class="stat-label">Anggota Hebat</span>
            </div>
            <div class="stat-box">
              <span class="stat-number">100%</span>
              <span class="stat-label">Dedikasi & Kerjasama</span>
            </div>
            <div class="stat-box">
              <span class="stat-number">X. D</span>
              <span class="stat-label">Kelas Kebanggaan</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer-container">
      <div class="footer-bubbles">
        <p class="footer-brand">🫧 BUBBLES HEART 💖</p>
        <p class="footer-copy">
          Dibuat dengan sepenuh hati oleh <strong>Kelompok 2 • Kelas X. D</strong><br>
          <em>Aura Dwi Ramadhani • Nadhifah Faiha • Farah Nabila • Kannisa Desfitra • Khalilla Andien</em>
        </p>
      </div>
    </footer>
  </div>

  <!-- Main JavaScript File -->
  <script src="script.js"></script>
</body>
</html>
