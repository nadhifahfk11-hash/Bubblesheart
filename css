/* ===================================================================
   🌸 BUBBLES HEART - STYLESHEET RESMI 🌸
   Kombinasi Tata Letak Terranova + Estetika Gambar Asli Bubbles Heart
   =================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Montserrat:wght@700;800;900&family=Quicksand:wght@500;600;700&display=swap');

:root {
  --sky-blue: #3b87f4;
  --sky-blue-deep: #1d68dc;
  --bubble-pink: #ff85b3;
  --bubble-pink-dark: #ff4785;
  --bubble-pink-light: #ffd6e5;
  --pink-floor: #ea869e;
  --gold-accent: #ffd166;
  
  --card-glass: rgba(255, 255, 255, 0.88);
  --border-pink: rgba(255, 182, 193, 0.85);
  --shadow-blue: 0 16px 45px rgba(29, 104, 220, 0.28);
  --shadow-pink: 0 16px 45px rgba(255, 71, 133, 0.35);
  
  --font-bubble: 'Fredoka', cursive, sans-serif;
  --font-title: 'Montserrat', sans-serif;
  --font-text: 'Quicksand', sans-serif;
}

/* Reset Dasar */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-text);
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
  
  /* Latar belakang: Menggunakan background.png pilihan Anda ATAU warna gradien biru langit persis gambar */
  background-color: var(--sky-blue);
  background: 
    url('background.png') center top / cover no-repeat fixed,
    linear-gradient(180deg, #2b7af0 0%, #3e8ef7 45%, #5ea3fc 75%, #ea869e 75%, #e27690 100%) fixed;
  background-size: cover;
  background-position: center top;
  background-attachment: fixed;
  background-repeat: no-repeat;
}

/* ===================================================================
   🌸 ORNAMEN KUPU-KUPU, BINTANG, DAN AWAN (PERSIS GAMBAR ANDA)
   =================================================================== */

/* Kupu-kupu Kiri & Kanan */
.butterfly-decor {
  position: fixed;
  z-index: 5;
  width: 90px;
  height: 90px;
  pointer-events: none;
  filter: drop-shadow(0 10px 20px rgba(255, 133, 179, 0.45));
}

.butterfly-left {
  top: 18%;
  left: 3%;
  animation: floatButterflyL 6s ease-in-out infinite alternate;
}

.butterfly-right {
  top: 22%;
  right: 3%;
  animation: floatButterflyR 7s ease-in-out infinite alternate;
}

.butterfly-decor .wing {
  position: absolute;
  width: 45px;
  height: 65px;
  background: radial-gradient(circle, #ffe6ee 0%, #ff9ebb 50%, #ff709b 100%);
  border-radius: 60% 40% 70% 30% / 50% 60% 40% 50%;
  opacity: 0.95;
  box-shadow: inset 0 0 10px rgba(255, 255, 255, 0.8);
}

.butterfly-decor .wing-l {
  left: 0;
  transform-origin: right center;
  animation: flapL 0.35s ease-in-out infinite alternate;
}

.butterfly-decor .wing-r {
  right: 0;
  transform-origin: left center;
  transform: scaleX(-1);
  animation: flapR 0.35s ease-in-out infinite alternate;
}

@keyframes flapL {
  0% { transform: rotateY(0deg); }
  100% { transform: rotateY(65deg); }
}

@keyframes flapR {
  0% { transform: scaleX(-1) rotateY(0deg); }
  100% { transform: scaleX(-1) rotateY(65deg); }
}

@keyframes floatButterflyL {
  0% { transform: translate(0, 0) rotate(-6deg); }
  100% { transform: translate(25px, -30px) rotate(10deg); }
}

@keyframes floatButterflyR {
  0% { transform: translate(0, 0) rotate(6deg); }
  100% { transform: translate(-25px, -30px) rotate(-10deg); }
}

/* Bintang-bintang Kuning Berkilau */
.star-decor {
  position: fixed;
  color: var(--gold-accent);
  z-index: 4;
  pointer-events: none;
  filter: drop-shadow(0 0 12px rgba(255, 209, 102, 0.9));
  animation: twinkleStar 2.5s ease-in-out infinite alternate;
}

.star-top-l1 { top: 12%; left: 16%; font-size: 2.2rem; }
.star-top-l2 { top: 18%; left: 20%; font-size: 1.5rem; animation-delay: 0.6s; }
.star-top-l3 { top: 22%; left: 17%; font-size: 1.8rem; animation-delay: 1.2s; }
.star-mid-r  { top: 48%; right: 22%; font-size: 2rem; animation-delay: 0.9s; }

@keyframes twinkleStar {
  0% { transform: scale(0.85) rotate(0deg); opacity: 0.6; }
  100% { transform: scale(1.25) rotate(20deg); opacity: 1; }
}

/* Awan Kecil Bawah */
.cloud-decor {
  position: fixed;
  bottom: 90px;
  right: 25%;
  font-size: 3rem;
  color: #ffffff;
  z-index: 4;
  pointer-events: none;
  filter: drop-shadow(0 6px 15px rgba(255, 133, 179, 0.4));
  animation: driftCloud 15s ease-in-out infinite alternate;
}

@keyframes driftCloud {
  0% { transform: translateX(0); }
  100% { transform: translateX(30px); }
}

/* ===================================================================
   🌸 CONTAINER UTAMA
   =================================================================== */
.main-wrapper {
  max-width: 1140px;
  margin: 0 auto;
  padding: 24px 20px 80px;
  position: relative;
  z-index: 10;
}

/* ===================================================================
   🌸 SEARCH BAR POJOK KANAN ATAS (PERSIS GAMBAR ANDA)
   =================================================================== */
.top-nav-bar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 24px;
}

.search-pill {
  display: flex;
  align-items: center;
  background: #1d68dc;
  border: 2px solid #ffd166;
  border-radius: 30px;
  padding: 4px 6px 4px 16px;
  width: 220px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
}

.search-pill input {
  background: transparent;
  border: none;
  outline: none;
  color: #ffffff;
  font-family: var(--font-text);
  font-size: 0.85rem;
  width: 100%;
}

.search-btn {
  background: #ffd166;
  color: #1d68dc;
  border: none;
  border-radius: 50%;
  width: 26px;
  height: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
  cursor: pointer;
}

/* ===================================================================
   🌸 1. TOP HERO CARD (BUBBLES HEART GAYA TERRANOVA + GAMBAR ASLI)
   =================================================================== */
.hero-top-card {
  background: var(--card-glass);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 3px solid rgba(255, 255, 255, 0.9);
  border-radius: 36px;
  padding: 50px 30px 42px;
  text-align: center;
  box-shadow: var(--shadow-blue), 0 0 0 2px var(--border-pink);
  margin-bottom: 28px;
  position: relative;
  overflow: hidden;
  transition: transform 0.3s ease;
}

.hero-top-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-pink), 0 0 0 2px #ff85b3;
}

/* Logo Hati di Atas */
.hero-logo-box {
  width: 120px;
  height: 120px;
  margin: 0 auto 16px;
  border-radius: 50%;
  padding: 8px;
  background: #ffffff;
  box-shadow: 
    0 10px 25px rgba(255, 71, 133, 0.3),
    0 0 0 3px var(--bubble-pink);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: floatLogo 4s ease-in-out infinite;
}

.hero-logo-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
}

@keyframes floatLogo {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

/* Badge Kelompok 2 */
.kelompok-badge {
  display: inline-block;
  background: rgba(255, 240, 245, 0.95);
  color: var(--bubble-pink-dark);
  border: 1.5px solid var(--bubble-pink);
  font-family: var(--font-title);
  font-size: 0.85rem;
  font-weight: 800;
  letter-spacing: 2px;
  padding: 6px 24px;
  border-radius: 30px;
  margin-bottom: 14px;
  box-shadow: 0 4px 12px rgba(255, 117, 160, 0.2);
}

/* Judul Balon 3D "BUBBLES HEART" Persis Gambar Anda! */
.giant-bubble-title {
  font-family: var(--font-bubble);
  font-size: clamp(2.8rem, 6.5vw, 5.2rem);
  font-weight: 700;
  letter-spacing: 2px;
  margin: 8px 0;
  line-height: 1.1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  flex-wrap: wrap;
}

.bubble-word {
  color: #ff9ec1;
  text-shadow: 
    0 3px 0 #ffffff,
    0 6px 0 #ff6b9d,
    0 10px 0 #e64980,
    0 16px 30px rgba(230, 73, 128, 0.55);
  animation: bounceWord 3s ease-in-out infinite alternate;
}

.ribbon-icon {
  font-size: 3.2rem;
  animation: wiggleRibbon 2.5s ease-in-out infinite;
}

@keyframes bounceWord {
  0% { transform: translateY(0); }
  100% { transform: translateY(-10px); }
}

@keyframes wiggleRibbon {
  0%, 100% { transform: scale(1) rotate(0deg); }
  50% { transform: scale(1.15) rotate(12deg); }
}

.hero-subtitle {
  font-family: var(--font-title);
  font-size: 1.15rem;
  font-weight: 800;
  color: #ffffff;
  background: linear-gradient(135deg, #1d68dc, #3b87f4);
  display: inline-block;
  padding: 6px 24px;
  border-radius: 20px;
  letter-spacing: 2px;
  margin-bottom: 22px;
  box-shadow: 0 4px 15px rgba(29, 104, 220, 0.35);
}

/* Tombol Kapsul Bawah */
.hero-pill-btn {
  display: inline-block;
  background: linear-gradient(135deg, #ff758c 0%, #ff8eb3 100%);
  color: #ffffff;
  font-family: var(--font-title);
  font-size: 0.95rem;
  font-weight: 800;
  letter-spacing: 2.5px;
  padding: 12px 38px;
  border-radius: 40px;
  box-shadow: 0 8px 24px rgba(255, 117, 140, 0.5);
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.hero-pill-btn:hover {
  transform: translateY(-3px) scale(1.05);
  box-shadow: 0 12px 30px rgba(255, 117, 140, 0.7);
}

/* ===================================================================
   🌸 2. PILL NAVBAR (MENU KAPSUL MELAYANG PERSIS TERRANOVA)
   =================================================================== */
.pill-navbar {
  display: flex;
  align-items: center;
  gap: 12px;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(14px);
  border: 2px solid var(--border-pink);
  border-radius: 50px;
  padding: 8px 12px;
  margin-bottom: 50px;
  box-shadow: var(--shadow-blue);
}

.nav-pill {
  text-decoration: none;
  font-family: var(--font-title);
  font-weight: 800;
  font-size: 0.95rem;
  color: #1d68dc;
  padding: 10px 30px;
  border-radius: 40px;
  transition: all 0.25s ease;
}

.nav-pill:hover {
  color: var(--bubble-pink-dark);
}

.nav-pill.active {
  background: linear-gradient(135deg, #ff758c 0%, #ff8eb3 100%);
  color: #ffffff;
  box-shadow: 0 4px 16px rgba(255, 117, 140, 0.5);
}

/* ===================================================================
   🌸 3. MIDDLE SECTION (ABOUT KELOMPOK - PARAGRAF - OUR MEMBER)
   =================================================================== */
.middle-section {
  display: grid;
  grid-template-columns: 240px 1fr 240px;
  gap: 28px;
  align-items: center;
  margin-bottom: 60px;
}

.title-col {
  display: flex;
  align-items: flex-start;
  gap: 16px;
}

.v-accent-bar {
  width: 6px;
  height: 75px;
  background: var(--bubble-pink-dark);
  border-radius: 4px;
  box-shadow: 0 0 14px rgba(255, 71, 133, 0.6);
  flex-shrink: 0;
}

.col-title {
  font-family: var(--font-title);
  font-size: 2.2rem;
  font-weight: 900;
  line-height: 1.1;
  color: #ffffff;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  letter-spacing: 1px;
}

.col-title .accent-text {
  color: #ffe6ee;
  text-shadow: 0 2px 10px rgba(255, 117, 160, 0.5);
}

.text-content-col {
  background: var(--card-glass);
  backdrop-filter: blur(14px);
  border: 2px solid var(--border-pink);
  border-radius: 26px;
  padding: 28px 30px;
  box-shadow: var(--shadow-blue);
}

.text-content-col p {
  color: #2d3748;
  font-size: 0.98rem;
  line-height: 1.8;
  text-align: justify;
  margin-bottom: 12px;
}

.text-content-col p:last-child {
  margin-bottom: 0;
}

/* ===================================================================
   🌸 4. OUR MEMBERS (5 LINGKARAN BERGELOMBANG BERCAHAYA PINK & BIRU)
   =================================================================== */
.members-grid-row {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  gap: 22px;
  flex-wrap: wrap;
  margin-bottom: 70px;
}

.member-col {
  text-align: center;
  flex: 0 0 195px;
  transition: transform 0.35s ease;
}

/* Efek Bergelombang Naik - Turun */
.stagger-up {
  margin-top: 0;
}

.stagger-down {
  margin-top: 45px;
}

/* Lingkaran Avatar Bercahaya */
.circle-avatar-wrap {
  width: 170px;
  height: 170px;
  margin: 0 auto 16px;
  position: relative;
}

.circle-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 30%, #ffffff 0%, #fff0f6 100%);
  border: 4px solid var(--bubble-pink);
  box-shadow: 
    0 12px 30px rgba(255, 117, 160, 0.45),
    inset 0 0 20px rgba(255, 182, 193, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.member-col:hover .circle-avatar {
  transform: scale(1.08);
  border-color: #ff4785;
  box-shadow: 0 16px 36px rgba(255, 71, 133, 0.6);
}

.avatar-icon {
  font-size: 3.5rem;
  z-index: 2;
  filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.15));
  transition: transform 0.3s ease;
}

.member-col:hover .avatar-icon {
  transform: scale(1.15) rotate(8deg);
}

.inner-horizon-line {
  position: absolute;
  top: 25%;
  left: 0;
  right: 0;
  height: 2px;
  background: rgba(255, 133, 179, 0.5);
  box-shadow: 0 0 8px rgba(255, 133, 179, 0.8);
}

/* Info Nama & Peran */
.role-badge {
  display: block;
  font-family: var(--font-title);
  font-size: 0.86rem;
  font-weight: 800;
  color: #ff4785;
  background: rgba(255, 255, 255, 0.9);
  padding: 4px 12px;
  border-radius: 20px;
  letter-spacing: 0.8px;
  margin-bottom: 6px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  display: inline-block;
}

.member-name {
  font-family: var(--font-title);
  font-size: 1.08rem;
  font-weight: 800;
  color: #ffffff;
  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
  letter-spacing: 0.4px;
}

/* ===================================================================
   🌸 5. FOOTER & LANTAI PINK
   =================================================================== */
.clean-footer {
  text-align: center;
  padding: 30px 20px 10px;
  font-size: 0.95rem;
  color: #ffffff;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
}

.clean-footer strong {
  color: #fff0f5;
}

/* Lantai Pink di Bagian Bawah (Persis Gambar Anda) */
.bottom-pink-floor {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 48px;
  background-color: var(--pink-floor);
  box-shadow: 0 -4px 15px rgba(234, 134, 158, 0.5);
  z-index: 2;
  pointer-events: none;
}

/* ===================================================================
   📱 RESPONSIF HP & TABLET
   =================================================================== */
@media (max-width: 900px) {
  .middle-section {
    grid-template-columns: 1fr;
    gap: 24px;
  }
  
  .right-col {
    justify-content: flex-start;
  }
  
  .stagger-down {
    margin-top: 0;
  }
  
  .butterfly-decor {
    display: none;
  }
}

@media (max-width: 600px) {
  .giant-bubble-title {
    font-size: 2.6rem;
  }
  
  .pill-navbar {
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .circle-avatar-wrap {
    width: 140px;
    height: 140px;
  }
}
