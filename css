@import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Quicksand:wght@500;600;700&display=swap');

:root {
  --primary-blue: #468af0;
  --sky-blue-light: #70a9fc;
  --bubble-pink: #ff85b3;
  --bubble-pink-dark: #ff5288;
  --soft-pink-bg: #fff0f5;
  --card-glass: rgba(255, 255, 255, 0.88);
  --border-pink: rgba(255, 182, 193, 0.75);
  --shadow-magic: 0 18px 45px rgba(70, 138, 240, 0.28);
  --text-dark: #2d3748;
}

/* 1. Latar Belakang Seluruh Layar (HTML) */
html {
  min-height: 100vh;
  margin: 0;
  padding: 0;
  font-family: 'Quicksand', sans-serif;
  scroll-behavior: smooth;
  
  /* Latar belakang: Memakai background.png pilihan Anda dengan perpaduan gradien langit biru & pink */
  background-color: #468af0;
  background-image: 
    url('background.png'),
    linear-gradient(180deg, #387ee9 0%, #4f93f7 50%, #68a6ff 78%, #ea869e 78%, #e27691 100%);
  background-size: cover;
  background-position: center top;
  background-repeat: no-repeat;
  background-attachment: fixed;
}

/* 2. Kartu Utama Halaman (Body) Berubah Menjadi Glassmorphism yang Elegan */
body {
  max-width: 820px;
  margin: 50px auto;
  padding: 45px 40px;
  background: var(--card-glass);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-radius: 30px;
  border: 2.5px solid var(--border-pink);
  box-shadow: var(--shadow-magic), 0 0 0 1px rgba(255, 255, 255, 0.8) inset;
  position: relative;
  overflow: hidden;
  animation: fadeInBody 0.8s ease-out;
}

/* Aksen Garis Pita Manis di Atas Kartu */
body::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8px;
  background: linear-gradient(90deg, #ff85b3, #468af0, #ff85b3);
}

/* 3. Judul Utama "Bubblesheart" (Efek Teks Balon 3D) */
h1 {
  font-family: 'Fredoka', sans-serif;
  font-size: clamp(2.4rem, 5vw, 3.4rem);
  font-weight: 700;
  text-align: center;
  color: #ff6b95;
  text-shadow: 
    0 2px 0 #ffffff,
    0 4px 0 #ff477e,
    0 8px 18px rgba(255, 71, 126, 0.45);
  letter-spacing: 1.5px;
  margin: 10px 0 20px;
  padding-bottom: 18px;
  border-bottom: 2px dashed var(--border-pink);
  animation: floatTitle 3s ease-in-out infinite;
}

/* 4. Menu Navigasi Beranda, Desain, Produk (Tombol Pill yang Interaktif) */
ul {
  display: flex;
  list-style-type: none;
  padding: 8px 16px;
  margin: 20px auto 30px;
  gap: 12px;
  justify-content: center;
  align-items: center;
  background: rgba(255, 240, 245, 0.85);
  border: 1.5px solid var(--border-pink);
  border-radius: 40px;
  width: fit-content;
  box-shadow: 0 4px 15px rgba(255, 133, 179, 0.2);
}

li {
  display: inline-block;
}

li a,
ul a {
  display: inline-block;
  font-family: 'Fredoka', sans-serif;
  font-weight: 600;
  font-size: 1rem;
  color: #e64980;
  text-decoration: none;
  padding: 8px 22px;
  border-radius: 25px;
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

li a:hover,
li a.active {
  background: linear-gradient(135deg, #ff758c 0%, #ff8eb3 100%);
  color: #ffffff;
  transform: translateY(-3px) scale(1.05);
  box-shadow: 0 6px 16px rgba(255, 117, 140, 0.45);
}

/* 5. Logo Bubblesheart dengan Bingkai Kaca & Animasi Mengambang */
img {
  width: 140px;
  height: auto;
  display: block;
  margin: 25px auto 15px;
  border-radius: 24px;
  padding: 12px;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 
    0 10px 25px rgba(70, 138, 240, 0.2),
    0 0 0 3px rgba(255, 182, 193, 0.6);
  transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  animation: floatLogo 4s ease-in-out infinite;
}

img:hover {
  transform: scale(1.1) rotate(4deg);
  box-shadow: 
    0 15px 35px rgba(255, 117, 140, 0.4),
    0 0 0 4px #ff758c;
}

/* 6. Judul Bagian: Filosofi Logo */
h2 {
  font-family: 'Fredoka', sans-serif;
  font-size: 1.8rem;
  font-weight: 700;
  color: #2b6cb0;
  text-align: center;
  margin: 25px 0 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

h2::before,
h2::after {
  content: '🌸';
  font-size: 1.3rem;
  animation: spinFlower 4s linear infinite;
}

/* 7. Paragraf Teks Filosofi yang Rapih & Nyaman Dibaca */
p {
  line-height: 1.9;
  color: var(--text-dark);
  text-align: justify;
  font-size: 1.05rem;
  background: rgba(255, 255, 255, 0.75);
  padding: 26px 30px;
  border-radius: 20px;
  border-left: 6px solid #ff758c;
  box-shadow: 0 6px 20px rgba(70, 138, 240, 0.08);
  margin-bottom: 25px;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

p:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(70, 138, 240, 0.14);
}

/* 8. Susunan Kartu Anggota Tim Kelompok 2 (Jika Ada di Halaman) */
.team-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  margin-top: 30px;
}

.member-card {
  background: rgba(255, 255, 255, 0.85);
  border: 1.5px solid var(--border-pink);
  border-radius: 20px;
  padding: 22px 18px;
  text-align: center;
  box-shadow: 0 8px 20px rgba(70, 138, 240, 0.12);
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.member-card:hover {
  transform: translateY(-6px) scale(1.03);
  background: #ffffff;
  border-color: #ff758c;
  box-shadow: 0 14px 28px rgba(255, 117, 140, 0.3);
}

.member-card h3 {
  font-family: 'Fredoka', sans-serif;
  color: #2d3748;
  font-size: 1.2rem;
  margin: 10px 0 4px;
}

.member-card .role-badge {
  display: inline-block;
  font-size: 0.78rem;
  font-weight: 700;
  padding: 4px 12px;
  border-radius: 15px;
  background: #fff0f5;
  color: #e64980;
  border: 1px solid #ffb6c1;
  text-transform: uppercase;
}

/* ===================================================================
   🎈 KEYFRAME ANIMASI INTERAKTIF & ESTETIK
   =================================================================== */

@keyframes floatTitle {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-7px); }
}

@keyframes floatLogo {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

@keyframes spinFlower {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes fadeInBody {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===================================================================
   📱 RESPONSIF PADA LAYAR HP & TABLET
   =================================================================== */
@media (max-width: 768px) {
  body {
    margin: 20px 14px;
    padding: 30px 20px;
    border-radius: 22px;
  }
  
  h1 {
    font-size: 2.3rem;
  }
  
  ul {
    flex-wrap: wrap;
    gap: 8px;
    padding: 6px 12px;
  }
  
  li a, ul a {
    padding: 6px 14px;
    font-size: 0.9rem;
  }
  
  p {
    padding: 20px;
    font-size: 0.98rem;
    text-align: left;
  }
}
