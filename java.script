// Navigasi Tab (Beranda, Desain, Produk)
function switchTab(tabName) {
    const contents = document.querySelectorAll('.tab-content');
    contents.forEach(el => el.classList.add('hidden'));

    const buttons = document.querySelectorAll('.tab-btn');
    buttons.forEach(btn => {
        btn.classList.remove('active', 'bg-blue-600', 'text-white');
        btn.classList.add('text-gray-600');
    });

    const activeContent = document.getElementById('content-' + tabName);
    if (activeContent) {
        activeContent.classList.remove('hidden');
    }

    const activeBtn = document.getElementById('tab-' + tabName);
    if (activeBtn) {
        activeBtn.classList.add('active');
        activeBtn.classList.remove('text-gray-600');
    }
}

// Buka Modal Pop-up Profil Anggota
function openMemberModal(name, role, desc, imgSrc, skills) {
    document.getElementById('modal-name').innerText = name;
    document.getElementById('modal-role').innerText = role;
    document.getElementById('modal-desc').innerText = desc;
    document.getElementById('modal-img').src = imgSrc;

    const skillsContainer = document.getElementById('modal-skills');
    skillsContainer.innerHTML = '';
    skills.forEach(skill => {
        const badge = document.createElement('span');
        badge.className = 'px-2.5 py-1 rounded-lg bg-pink-50 text-pink-600 text-xs font-semibold border border-pink-100';
        badge.innerText = skill;
        skillsContainer.appendChild(badge);
    });

    const modal = document.getElementById('member-modal');
    const container = document.getElementById('modal-container');
    
    modal.classList.remove('hidden');
    setTimeout(() => {
        container.classList.remove('scale-95', 'opacity-0');
        container.classList.add('scale-100', 'opacity-100');
    }, 10);
}

// Tutup Modal Pop-up Profil Anggota
function closeMemberModal() {
    const modal = document.getElementById('member-modal');
    const container = document.getElementById('modal-container');

    container.classList.remove('scale-100', 'opacity-100');
    container.classList.add('scale-95', 'opacity-0');
    
    setTimeout(() => {
        modal.classList.add('hidden');
    }, 300);
}

// Kontrol Layar Penuh Presentasi PPT
function toggleFullScreenPPT() {
    const iframe = document.getElementById('ppt-iframe');
    if (iframe.requestFullscreen) {
        iframe.requestFullscreen();
    } else if (iframe.webkitRequestFullscreen) {
        iframe.webkitRequestFullscreen();
    } else if (iframe.msRequestFullscreen) {
        iframe.msRequestFullscreen();
    }
}
