// 1. Audio Synth untuk Efek Suara "Pop" Gelembung
let audioCtx = null;

function initAudio() {
  if (!audioCtx) {
    const AudioContext = window.AudioContext || window.webkitAudioContext;
    audioCtx = new AudioContext();
  }
}

function playPopSound(frequency = 540) {
  try {
    initAudio();
    if (audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    
    osc.type = 'sine';
    const now = audioCtx.currentTime;
    
    osc.frequency.setValueAtTime(frequency, now);
    osc.frequency.exponentialRampToValueAtTime(frequency * 1.5, now + 0.04);
    osc.frequency.exponentialRampToValueAtTime(frequency * 0.4, now + 0.12);
    
    gain.gain.setValueAtTime(0.18, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);
    
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    
    osc.start(now);
    osc.stop(now + 0.13);
  } catch (e) {
    // Fallback silent
  }
}

// 2. Partikel Sparkles saat Klik
function createSparkles(x, y) {
  const colors = ['#38bdf8', '#ffffff', '#93c5fd', '#ff85b3'];
  const count = 8;
  
  for (let i = 0; i < count; i++) {
    const p = document.createElement('div');
    p.style.position = 'fixed';
    p.style.left = `${x}px`;
    p.style.top = `${y}px`;
    p.style.width = '6px';
    p.style.height = '6px';
    p.style.borderRadius = '50%';
    p.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
    p.style.zIndex = '9999';
    p.style.pointerEvents = 'none';
    p.style.boxShadow = '0 0 8px rgba(56, 189, 248, 0.9)';
    
    document.body.appendChild(p);
    
    const angle = (i / count) * Math.PI * 2;
    const distance = Math.random() * 35 + 20;
    const destX = x + Math.cos(angle) * distance;
    const destY = y + Math.sin(angle) * distance;
    
    p.animate([
      { transform: 'translate(0, 0) scale(1)', opacity: 1 },
      { transform: `translate(${destX - x}px, ${destY - y}px) scale(0)`, opacity: 0 }
    ], {
      duration: 380,
      easing: 'ease-out'
    }).onfinish = () => p.remove();
  }
}

// 3. Interaktivitas Elemen
document.addEventListener('DOMContentLoaded', () => {
  // Klik Navbar Pills
  const navPills = document.querySelectorAll('.nav-pill');
  navPills.forEach(pill => {
    pill.addEventListener('click', (e) => {
      navPills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      playPopSound(580);
      createSparkles(e.clientX, e.clientY);
    });
  });

  // Klik Anggota Tim & Tombol
  const interactiveItems = document.querySelectorAll('.hero-pill-btn, .member-col, .hero-logo-box');
  interactiveItems.forEach(item => {
    item.addEventListener('click', (e) => {
      playPopSound(Math.floor(Math.random() * 140) + 480);
      createSparkles(e.clientX, e.clientY);
    });
  });
});
