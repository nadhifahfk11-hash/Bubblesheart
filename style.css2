/* ===================================================================
   🌸 TEMA GITHUB: BUBBLES HEART THEME (GLASSMORPHISM) 🌸
   =================================================================== */

:root {
  --bubbles-card-bg: rgba(255, 255, 255, 0.82);
  --bubbles-border: rgba(255, 182, 193, 0.5);
  --bubbles-shadow: 0 8px 32px 0 rgba(142, 180, 240, 0.25);
}

/* 1. Pasang Gambar Background Utama */
html,
body {
  background-image: url('URL_GAMBAR_ANDA_DISINI') !important; /* Ganti dengan link gambar Anda */
  background-size: cover !important;
  background-position: center center !important;
  background-repeat: no-repeat !important;
  background-attachment: fixed !important;
  min-height: 100vh !important;
}

/* 2. Buat Kontainer Utama Menjadi Transparan agar Gambar Terlihat */
.application-main,
main,
.pagehead,
.repohead,
#js-repo-pjax-container,
.repository-content,
div[data-color-mode],
.Layout-main,
.Layout-sidebar {
  background: transparent !important;
  background-color: transparent !important;
}

/* 3. Header / Navbar Atas dengan Efek Kaca (Glassmorphism) */
header.AppHeader,
.Header,
.Header-old,
header[role="banner"] {
  background-color: rgba(255, 255, 255, 0.75) !important;
  backdrop-filter: blur(12px) !important;
  -webkit-backdrop-filter: blur(12px) !important;
  border-bottom: 2px solid var(--bubbles-border) !important;
}

/* 4. Box / Card Konten (Repo, Readme, Profil, Timeline, dll.) */
.Box,
.Box-header,
.Box-body,
.Box-footer,
.border,
.TimelineItem-badge,
.timeline-comment,
.Subhead,
.user-profile-nav,
.UnderlineNav,
.color-bg-default,
.color-bg-subtle,
.js-pinned-items-reorder-container .pinned-item-list-item,
[data-color-mode] .color-bg-default {
  background-color: var(--bubbles-card-bg) !important;
  backdrop-filter: blur(10px) !important;
  -webkit-backdrop-filter: blur(10px) !important;
  border: 1px solid var(--bubbles-border) !important;
  border-radius: 12px !important;
  box-shadow: var(--bubbles-shadow) !important;
}

/* 5. Tombol dengan Aksen Pink Khas Bubbles Heart */
.btn-primary {
  background: linear-gradient(135deg, #ff758c 0%, #ff7eb3 100%) !important;
  border-color: #ff758c !important;
  color: #ffffff !important;
  border-radius: 20px !important;
}
