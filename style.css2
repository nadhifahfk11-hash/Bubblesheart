/* ===================================================================
   🌸 BUBBLES HEART - STYLESHEET RESMI 🌸
   Kelompok 2 | Kelas X. D
   =================================================================== */

:root {
  --primary-blue: #468af0;
  --sky-blue-light: #70a9fc;
  --sky-blue-dark: #2d6cd4;
  --bubble-pink: #ff85b3;
  --bubble-pink-light: #ffa6c8;
  --bubble-pink-dark: #e85d92;
  --accent-gold: #ffe066;
  --ground-pink: #ea869e;
  
  --glass-bg: rgba(255, 255, 255, 0.82);
  --glass-bg-hover: rgba(255, 255, 255, 0.94);
  --glass-border: rgba(255, 192, 203, 0.65);
  --glass-shadow: 0 12px 35px 0 rgba(70, 138, 240, 0.22);
  
  --text-dark: #2c3e50;
  --text-muted: #64748b;
  --text-pink: #d9467d;
  
  --font-main: 'Fredoka', 'Quicksand', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-body: 'Quicksand', var(--font-main);
}

/* Reset Dasar */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-body);
  color: var(--text-dark);
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
  
  /* Latar belakang: Coba muat background.png milik Anda, jika belum ada otomatis fallback ke gradien langit biru estetik */
  background: 
    linear-gradient(180deg, #387ee9 0%, #4f93f7 50%, #68a6ff 82%, #ea869e 82%, #e57c95 100%);
  background-image: 
    url('background.png'),
    linear-gradient(180deg, #387ee9 0%, #4f93f7 50%, #68a6ff 82%, #ea869e 82%, #e57c95 100%);
  background-size: cover;
  background-position: center top;
  background-attachment: fixed;
  background-repeat: no-repeat;
}

/* Container Pembungkus */
.page-wrapper {
  position: relative;
  z-index: 10;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px 24px 60px;
}

/* ===================================================================
   🎈 ANIMASI ELEMEN MELAYANG (BUBBLES, BUTTERFLIES, STARS, CLOUDS)
   =================================================================== */

/* Container Gelembung Interaktif */
.bubble-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 5;
  overflow: hidden;
}

.floating-bubble {
  position: absolute;
  pointer-events: auto;
  cursor: pointer;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.9), rgba(255, 192, 203, 0.5) 45%, rgba(135, 206, 250, 0.4) 80%, rgba(255, 255, 255, 0.8) 100%);
  box-shadow: 
    inset 0 0 15px rgba(255, 255, 255, 0.8),
    0 4px 15px rgba(70, 138, 240, 0.25);
  animation: floatUp 12s linear infinite;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.floating-bubble::after {
  content: '';
  position: absolute;
  top: 15%;
  left: 20%;
  width: 25%;
  height: 25%;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
}

.floating-bubble:hover {
  transform: scale(1.15);
}

@keyframes floatUp {
  0% {
    transform: translateY(110vh) translateX(0) rotate(0deg);
    opacity: 0;
  }
  10% {
    opacity: 0.85;
  }
  50% {
    transform: translateY(50vh) translateX(25px) rotate(180deg);
  }
  90% {
    opacity: 0.85;
  }
  100% {
    transform: translateY(-10vh) translateX(-25px) rotate(360deg);
    opacity: 0;
  }
}

/* Kupu-kupu Animasi Lucu */
.butterfly {
  position: fixed;
  z-index: 6;
  width: 50px;
  height: 45px;
  pointer-events: none;
  perspective: 300px;
}

.butterfly-left {
  top: 15%;
  left: 3%;
  animation: flutterLeft 14s ease-in-out infinite alternate;
}

.butterfly-right {
  top: 25%;
  right: 4%;
  animation: flutterRight 16s ease-in-out infinite alternate;
}

.butterfly .body {
  position: absolute;
  left: 50%;
  top: 20%;
  transform: translateX(-50%);
  width: 4px;
  height: 26px;
  background: #ff758c;
  border-radius: 10px;
  box-shadow: 0 0 8px rgba(255, 117, 140, 0.6);
}

.butterfly .wing {
  position: absolute;
  top: 0;
  width: 26px;
  height: 38px;
  background: radial-gradient(circle, #ffccd5 0%, #ff85a2 70%, #ff4d6d 100%);
  border-radius: 60% 40% 70% 30% / 50% 60% 40% 50%;
  opacity: 0.9;
  box-shadow: 0 4px 10px rgba(255, 133, 162, 0.4);
}

.butterfly .left-wing {
  left: 0;
  transform-origin: right center;
  animation: flapLeft 0.35s ease-in-out infinite alternate;
}

.butterfly .right-wing {
  right: 0;
  transform-origin: left center;
  transform: scaleX(-1);
  animation: flapRight 0.35s ease-in-out infinite alternate;
}

@keyframes flapLeft {
  0% { transform: rotateY(0deg); }
  100% { transform: rotateY(70deg); }
}

@keyframes flapRight {
  0% { transform: scaleX(-1) rotateY(0deg); }
  100% { transform: scaleX(-1) rotateY(70deg); }
}

@keyframes flutterLeft {
  0% { transform: translate(0, 0) rotate(-5deg); }
  33% { transform: translate(30px, -40px) rotate(15deg); }
  66% { transform: translate(15px, 30px) rotate(-10deg); }
  100% { transform: translate(45px, -15px) rotate(8deg); }
}

@keyframes flutterRight {
  0% { transform: translate(0, 0) rotate(5deg); }
  33% { transform: translate(-35px, 35px) rotate(-12deg); }
  66% { transform: translate(-10px, -30px) rotate(10deg); }
  100% { transform: translate(-40px, 15px) rotate(-6deg); }
}

/* Dekorasi Awan & Bintang */
.cloud-decor {
  position: fixed;
  color: rgba(255, 255, 255, 0.85);
  font-size: 3.5rem;
  z-index: 4;
  filter: drop-shadow(0 8px 12px rgba(70, 138, 240, 0.2));
  animation: driftCloud 25s linear infinite alternate;
  pointer-events: none;
}
.cloud-1 { top: 68%; left: 8%; font-size: 4rem; }
.cloud-2 { top: 40%; right: 7%; font-size: 3rem; }

@keyframes driftCloud {
  0% { transform: translateX(0); }
  100% { transform: translateX(40px); }
}

.star-decor {
  position: fixed;
  color: var(--accent-gold);
  font-size: 1.8rem;
  z-index: 4;
  pointer-events: none;
  filter: drop-shadow(0 0 10px rgba(255, 224, 102, 0.8));
  animation: twinkle 2.5s ease-in-out infinite alternate;
}
.star-1 { top: 12%; left: 22%; font-size: 2.2rem; animation-delay: 0.2s; }
.star-2 { top: 22%; left: 26%; font-size: 1.5rem; animation-delay: 0.8s; }
.star-3 { top: 32%; right: 20%; font-size: 2rem; animation-delay: 0.4s; }
.star-4 { top: 18%; right: 28%; font-size: 1.4rem; animation-delay: 1.1s; }

@keyframes twinkle {
  0% { transform: scale(0.85) rotate(0deg); opacity: 0.6; }
  100% { transform: scale(1.2) rotate(18deg); opacity: 1; }
}

/* ===================================================================
   🌸 NAVBAR / HEADER ATAS
   =================================================================== */
.navbar-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 24px;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1.5px solid var(--glass-border);
  border-radius: 40px;
  box-shadow: var(--glass-shadow);
  margin-bottom: 30px;
  transition: all 0.3s ease;
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 700;
  font-size: 1.25rem;
  color: var(--bubble-pink-dark);
  letter-spacing: 0.5px;
}

.nav-brand .brand-icon {
  font-size: 1.5rem;
  animation: pulseIcon 2s infinite ease-in-out;
}

@keyframes pulseIcon {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.2); }
}

.nav-pill {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 133, 179, 0.15);
  border: 1px solid rgba(255, 133, 179, 0.35);
  padding: 6px 16px;
  border-radius: 20px;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--bubble-pink-dark);
}

.sound-toggle-btn {
  background: linear-gradient(135deg, #ff758c 0%, #ff7eb3 100%);
  color: white;
  border: none;
  padding: 8px 18px;
  border-radius: 30px;
  font-family: var(--font-main);
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 4px 12px rgba(255, 117, 140, 0.4);
  transition: all 0.25s ease;
}

.sound-toggle-btn:hover {
  transform: translateY(-2px) scale(1.04);
  box-shadow: 0 6px 16px rgba(255, 117, 140, 0.6);
}

/* ===================================================================
   🌸 HERO SECTION (BUBBLES HEART BANNER)
   =================================================================== */
.hero-section {
  text-align: center;
  margin-bottom: 50px;
}

.banner-wrapper {
  margin-bottom: 25px;
  border-radius: 26px;
  overflow: hidden;
  box-shadow: 0 16px 40px rgba(70, 138, 240, 0.35);
  border: 3px solid rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  transition: transform 0.35s ease, box-shadow 0.35s ease;
}

.banner-wrapper:hover {
  transform: translateY(-4px) scale(1.01);
  box-shadow: 0 20px 48px rgba(255, 117, 140, 0.45);
}

.hero-banner-image {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
}

.hero-card {
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 2px solid var(--glass-border);
  border-radius: 28px;
  padding: 45px 30px 40px;
  box-shadow: var(--glass-shadow);
  position: relative;
  overflow: hidden;
}

.hero-tag {
  display: inline-block;
  background: linear-gradient(135deg, rgba(255, 117, 140, 0.15), rgba(70, 138, 240, 0.15));
  border: 1.5px dashed var(--bubble-pink);
  padding: 6px 20px;
  border-radius: 25px;
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--bubble-pink-dark);
  letter-spacing: 1px;
  margin-bottom: 20px;
}

/* Judul Balon 3D "BUBBLES HEART" */
.hero-title {
  font-family: var(--font-main);
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 700;
  letter-spacing: 2px;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  flex-wrap: wrap;
}

.title-bubbles {
  color: #ff94ba;
  text-shadow: 
    0 2px 0 #fff,
    0 4px 0 #ff6699,
    0 8px 16px rgba(255, 102, 153, 0.5);
  animation: bounceBubble 3s infinite ease-in-out;
}

.title-heart {
  color: #ff75a0;
  text-shadow: 
    0 2px 0 #fff,
    0 4px 0 #e64980,
    0 8px 16px rgba(230, 73, 128, 0.5);
  animation: bounceBubble 3s infinite ease-in-out 0.3s;
}

.ribbon-decor {
  font-size: 2.8rem;
  animation: wiggleRibbon 2.5s infinite ease-in-out;
}

@keyframes bounceBubble {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

@keyframes wiggleRibbon {
  0%, 100% { transform: rotate(0deg) scale(1); }
  25% { transform: rotate(-8deg) scale(1.1); }
  75% { transform: rotate(8deg) scale(1.1); }
}

.hero-subtitle {
  font-size: 1.15rem;
  line-height: 1.7;
  color: var(--text-dark);
  max-width: 680px;
  margin: 0 auto 30px;
}

.hero-action-row {
  display: flex;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
}

.btn-bubble {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 12px 28px;
  border-radius: 30px;
  font-family: var(--font-main);
  font-weight: 600;
  font-size: 1rem;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.btn-primary {
  background: linear-gradient(135deg, #ff6b8b 0%, #ff8eaf 100%);
  color: #ffffff;
  box-shadow: 0 6px 18px rgba(255, 107, 139, 0.45);
  border: none;
}

.btn-primary:hover {
  transform: translateY(-3px) scale(1.05);
  box-shadow: 0 10px 24px rgba(255, 107, 139, 0.65);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.9);
  color: var(--primary-blue);
  border: 2px solid var(--primary-blue);
  box-shadow: 0 4px 14px rgba(70, 138, 240, 0.2);
}

.btn-secondary:hover {
  background: var(--primary-blue);
  color: #ffffff;
  transform: translateY(-3px) scale(1.05);
}

/* ===================================================================
   🌸 SUSUNAN TIM (TEAM MEMBERS SECTION)
   =================================================================== */
.team-section {
  margin-bottom: 60px;
}

.section-header {
  text-align: center;
  margin-bottom: 40px;
}

.section-badge {
  display: inline-block;
  font-size: 0.9rem;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #ff758c 0%, #ff7eb3 100%);
  padding: 6px 20px;
  border-radius: 20px;
  box-shadow: 0 4px 12px rgba(255, 117, 140, 0.35);
  margin-bottom: 12px;
}

.section-title {
  font-family: var(--font-main);
  font-size: 2.3rem;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  margin-bottom: 8px;
}

.section-desc {
  color: #ffffff;
  font-size: 1.05rem;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
}

/* Grid Kartu Anggota */
.team-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 26px;
}

/* Kartu Tiap Anggota */
.member-card {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 2px solid var(--glass-border);
  border-radius: 24px;
  padding: 32px 24px 26px;
  text-align: center;
  position: relative;
  overflow: hidden;
  box-shadow: var(--glass-shadow);
  transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.member-card:hover {
  transform: translateY(-8px) scale(1.02);
  background: var(--glass-bg-hover);
  box-shadow: 0 18px 40px 0 rgba(70, 138, 240, 0.32);
  border-color: #ff85a2;
}

/* Badge Posisi / Role */
.role-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 0.82rem;
  font-weight: 700;
  padding: 6px 14px;
  border-radius: 20px;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  margin-bottom: 20px;
}

.badge-programmer {
  background: #e0f2fe;
  color: #0369a1;
  border: 1px solid #7dd3fc;
}

.badge-architect {
  background: #fdf2f8;
  color: #be185d;
  border: 1px solid #fbcfe8;
}

.badge-developer {
  background: #f0fdf4;
  color: #15803d;
  border: 1px solid #bbf7d0;
}

.badge-designer {
  background: #fef3c7;
  color: #b45309;
  border: 1px solid #fde68a;
}

/* Avatar Lingkaran */
.avatar-wrapper {
  position: relative;
  width: 96px;
  height: 96px;
  margin: 0 auto 18px;
}

.avatar-ring {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffd6e0 0%, #ff85a2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 
    0 8px 20px rgba(255, 133, 162, 0.4),
    inset 0 2px 6px rgba(255, 255, 255, 0.8);
  transition: transform 0.3s ease;
}

.member-card:hover .avatar-ring {
  transform: rotate(10deg) scale(1.06);
}

.avatar-emoji {
  font-size: 2.8rem;
}

.sparkle-bubble {
  position: absolute;
  bottom: 0;
  right: 0;
  background: #ffffff;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
  border: 1px solid var(--bubble-pink-light);
}

/* Nama & Deskripsi Anggota */
.member-name {
  font-family: var(--font-main);
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--text-dark);
  margin-bottom: 4px;
}

.member-title {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--bubble-pink-dark);
  margin-bottom: 14px;
}

.member-desc {
  font-size: 0.92rem;
  line-height: 1.6;
  color: var(--text-muted);
  margin-bottom: 20px;
}

/* Skill Tags */
.skills-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  justify-content: center;
}

.tag {
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid rgba(255, 182, 193, 0.6);
  color: var(--text-dark);
  font-size: 0.76rem;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 12px;
  transition: all 0.2s ease;
}

.member-card:hover .tag {
  background: #ffffff;
  border-color: #ff70a6;
  color: #ff528c;
}

/* ===================================================================
   🌸 ABOUT SECTION
   =================================================================== */
.about-section {
  margin-bottom: 50px;
}

.about-card {
  background: var(--glass-bg);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border: 2px solid var(--glass-border);
  border-radius: 28px;
  padding: 40px 36px;
  box-shadow: var(--glass-shadow);
  text-align: center;
}

.about-title {
  font-family: var(--font-main);
  font-size: 2.1rem;
  font-weight: 700;
  color: var(--text-dark);
  margin: 10px 0 16px;
}

.about-text {
  font-size: 1.05rem;
  line-height: 1.8;
  color: var(--text-dark);
  max-width: 820px;
  margin: 0 auto 16px;
}

.stats-row {
  display: flex;
  justify-content: center;
  gap: 30px;
  flex-wrap: wrap;
  margin-top: 30px;
  padding-top: 25px;
  border-top: 1.5px dashed rgba(255, 182, 193, 0.7);
}

.stat-box {
  background: rgba(255, 255, 255, 0.85);
  border: 1.5px solid var(--bubble-pink-light);
  border-radius: 20px;
  padding: 16px 28px;
  min-width: 150px;
  box-shadow: 0 4px 15px rgba(255, 133, 162, 0.15);
  transition: transform 0.25s ease;
}

.stat-box:hover {
  transform: translateY(-4px) scale(1.05);
}

.stat-number {
  display: block;
  font-family: var(--font-main);
  font-size: 2.2rem;
  font-weight: 700;
  color: var(--bubble-pink-dark);
}

.stat-label {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-muted);
}

/* ===================================================================
   🌸 FOOTER
   =================================================================== */
.footer-container {
  text-align: center;
  padding: 30px 20px 10px;
}

.footer-bubbles {
  background: var(--glass-bg);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1.5px solid var(--glass-border);
  border-radius: 30px;
  padding: 24px;
  box-shadow: var(--glass-shadow);
  display: inline-block;
  max-width: 800px;
  width: 100%;
}

.footer-brand {
  font-family: var(--font-main);
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--bubble-pink-dark);
  margin-bottom: 8px;
}

.footer-copy {
  font-size: 0.95rem;
  line-height: 1.6;
  color: var(--text-dark);
}

/* Responsif Mobile & Tablet */
@media (max-width: 768px) {
  .page-wrapper {
    padding: 15px 16px 40px;
  }
  
  .navbar-container {
    flex-direction: column;
    gap: 12px;
    border-radius: 24px;
    padding: 14px 20px;
  }
  
  .hero-card {
    padding: 30px 18px;
  }
  
  .hero-title {
    font-size: 2.4rem;
    gap: 8px;
  }
  
  .team-grid {
    grid-template-columns: 1fr;
  }
  
  .butterfly {
    display: none; /* Sembunyikan kupu-kupu di layar kecil agar tidak menutupi teks */
  }
}
